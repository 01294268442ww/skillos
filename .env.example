# Azure OpenAI
AZURE_OPENAI=1
OPENAI_API_KEY=your-api-key-here
AZURE_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_API_VERSION=2025-01-01-preview
DEFAULT_MODEL=gpt-4o

# Judge
DEFAULT_JUDGE_MODEL=gpt-4o
JUDGE_API_KEY=your-api-key-here
JUDGE_API_BASE=https://your-endpoint.openai.azure.com/

# vLLM (for local models)
# DISABLE_THINKING=1
# JUDGE_USE_VLLM=1
# JUDGE_VLLM_URL=http://localhost:8000/v1
# EMBEDDING_DEVICE=cuda:0

# Web Search (Google Serper)
SERPER_API_KEY=your-serper-api-key-here

# Page Crawling (Jina Reader API)
JINA_API_KEY=your-jina-api-key-here
WEB_ACCESS_PROVIDER=jina

# HyperSkill memory (optional overrides; defaults live in hyperskill/config.py)
# HYPERSKILL_K=5
# HYPERSKILL_BETA=0.7
# HYPERSKILL_PRUNE_THRESHOLD=0.2
# HYPERSKILL_MERGE_THRESHOLD=0.85
# HYPERSKILL_MAINTENANCE_RATIO=0.1
# HYPERSKILL_DOMAIN=gaia            # set automatically by the runners
